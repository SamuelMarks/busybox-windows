# Default behavior: let git auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
LICENSE* text eol=lf

# Enforce CRLF for Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Enforce LF for patch files. This is critically important because
# `git apply` will often fail if patch files have CRLF line endings.
# Stored patch files may legitimately contain whitespace in diff context.
*.patch text eol=lf -whitespace
*.diff text eol=lf -whitespace

# Enforce LF for shell scripts (if any are added)
*.sh text eol=lf
